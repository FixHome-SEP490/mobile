{
  "expo": {
    "name": "FixHome",
    "slug": "fixhome-mobile",
    "version": "0.1.0",
    "scheme": "fixhome",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FixHome cần quyền camera để bạn chụp ảnh CCCD/CMND và ảnh chân dung khi xác minh danh tính.",
          "photosPermission": "FixHome cần quyền thư viện ảnh để bạn chọn ảnh CCCD/CMND có sẵn khi xác minh danh tính."
        }
      ],
      "expo-web-browser"
    ]
  }
}
