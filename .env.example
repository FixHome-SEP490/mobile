# Backend base URL. The chat WebSocket is derived from this value by stripping
# the /api/v1 suffix, so REST and realtime always point at the same server.
#
#   Android emulator : http://10.0.2.2:<port>/api/v1   (localhost is the emulator itself)
#   iOS simulator    : http://localhost:<port>/api/v1
#   Real device      : http://<your-LAN-IP>:<port>/api/v1
#
# Leaving this unset is the safest option: the app then falls back to 10.0.2.2
# on Android and localhost elsewhere (see src/constants/config.ts).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_APP_NAME=FixHome

# ── Đăng nhập Google ─────────────────────────────────────────────────────────
# Mobile KHÔNG cần Client ID nào cả: app chỉ mở trình duyệt trỏ vào backend,
# backend mới là bên nói chuyện với Google. Nhờ vậy không ai phải khai báo vân
# tay SHA-1 của máy mình lên Google Console.
#
# Nhưng khi test trên emulator Android thì cần đúng một lệnh chuẩn bị:
#
#   adb reverse tcp:3000 tcp:3000
#
# Lý do: sau khi người dùng đăng nhập, Google chuyển trình duyệt về
# http://localhost:3000/... — mà "localhost" bên trong emulator là chính
# emulator, không phải máy thật. Lệnh trên bắc cầu cổng 3000 sang máy thật.
# Không chạy thì màn hình Google hiện ra bình thường nhưng bước quay về sẽ báo
# không kết nối được.
